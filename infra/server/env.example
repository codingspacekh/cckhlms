# /opt/cckhlms/.env on the VPS. Owner-only (chmod 600). Never commit real values.
# Generate random values with:  openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# First admin, used only when no admin exists yet. Remove both lines after the first sign-in.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker command)
TUNNEL_TOKEN=
# Cloudflare R2 (bucket + an API token with Object Read & Write on that bucket only)
R2_ACCOUNT_ID=
R2_BUCKET=cckhlms-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# age PUBLIC key (age1…). The private key stays in the owner's password manager, never on the server.
BACKUP_AGE_RECIPIENT=
# Optional: healthchecks.io ping URL, which alerts if a backup fails or is missed
BACKUP_PING_URL=
