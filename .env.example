# Copy to .env for local development. Production values live only on the server (infra/README).
DATABASE_URL=postgres://lms:lms-dev-only@localhost:54329/lms
BETTER_AUTH_URL=http://lms.localhost:3300
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
PREVIEW_ORIGIN=http://preview.localhost:3102
# First admin, created at start-up only if no admin exists yet
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-long-password
