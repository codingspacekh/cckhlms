{
  "name": "cckhlms",
  "private": true,
  "version": "0.1.0",
  "description": "CCKH coding club LMS",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "preview": "node preview/server.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "seed:dev": "tsx --env-file=.env scripts/seed-dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project component",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:int:coverage": "vitest run --project integration --coverage --coverage.include=src/server/** --coverage.include=src/db/** --coverage.include=src/modules/** --coverage.exclude=src/modules/**/*actions.ts --coverage.exclude=src/server/policy.ts --coverage.exclude=src/server/guard.ts --coverage.exclude=src/server/action-result.ts --coverage.exclude=src/db/schema.ts --coverage.thresholds.lines=85 --coverage.thresholds.branches=75 --coverage.thresholds.functions=85"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-khmer": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.7",
    "codemirror": "6.0.2",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "geist": "1.7.2",
    "markdown-it": "15.0.2",
    "next": "16.3.8",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    },
    "@codemirror/language": "6.12.4",
    "@lezer/css": "1.3.8",
    "@lezer/java": "1.1.4",
    "@lezer/lr": "1.4.10"
  }
}
